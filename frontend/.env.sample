# Which backend the frontend talks to.
#
# Vite resolves these by mode, highest priority first:
#
#   1. shell environment      (bin/deploy-frontend.sh exports VITE_API_URL)
#   2. .env.development.local (npm run dev only)   <- point this at your local API
#   3. .env.local             (written by bin/generate-env.sh: the CloudFront URL)
#   4. .env.sample is NOT loaded by Vite - it is documentation only
#
# The result: `npm run dev` uses your local backend, while `npm run build` and
# bin/deploy-frontend.sh use the deployed one. Nothing in the code branches.
#
# .gitignore ignores ".env.*", so .env.development.local stays on your machine.

# --- deployed (written automatically by ./bin/generate-env.sh) ---------------
VITE_API_URL=https://your-distribution.cloudfront.net
VITE_API_ENDPOINTS='{"facility-api":"/api/facility-api"}'

# --- local development: copy into .env.development.local ---------------------
# ./bin/start-dev.sh serves the backend through a CORS proxy on port 3001:
#   VITE_API_URL=http://localhost:3001

# Legacy Create React App names, kept for compatibility with bin/generate-env.sh
REACT_APP_API_URL=https://your-distribution.cloudfront.net
REACT_APP_API_ENDPOINTS='{"facility-api":"/api/facility-api"}'
